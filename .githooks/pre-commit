#!/usr/bin/env sh
set -eu

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
AUBE_BIN="$(command -v aube || true)"

run_aube() {
  if [ -n "$AUBE_BIN" ]; then
    "$AUBE_BIN" "$@"
  else
    npx -y @endevco/aube@1.16.0 "$@"
  fi
}

run_aube run toolchain:check
run_aube exec --no-install lint-staged

case "$STAGED_FILES" in
  *apps/android/*)
    (
      cd apps/android
      ./gradlew --max-workers=2 spotlessCheck
    )
    ;;
  *)
    echo "Skipping Android formatting; no staged Android files."
    ;;
esac
