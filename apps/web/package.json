    "@libsql/client": "latest",
    "dexie": "latest",
    "hono": "latest",
    "lucide-svelte": "latest"
  },
  "devDependencies": {
    "@author/test-fixtures": "workspace:*",
    "@playwright/test": "latest",
    "@sveltejs/adapter-node": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/node": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
