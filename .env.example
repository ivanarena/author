# Production/self-host template. Copy to an ignored live env file and replace
# every placeholder before use. Do not reuse this file for local staging smoke.
AUTHOR_DEPLOY_TARGET=production
# Compose host binding; the container always listens on port 3000.
HOST_PORT=3000
NOTES_DB_PATH=/data/notes.sqlite

NOTES_LOGIN_USERNAME=owner
# Bootstrap password for the first account only when no user exists yet.
# This is not an existing account password reset knob.
NOTES_LOGIN_PASSWORD=change-this-long-bootstrap-password
NOTES_AUTH_SESSION_DAYS=90
NOTES_TRUST_PROXY_HEADERS=false
NOTES_TRUST_CLOUDFLARE_HEADERS=false
NOTES_SERVER_SECRET=change-this-server-secret
NOTES_METRICS_PUBLIC=false
NOTES_METRICS_TOKEN=change-this-long-random-metrics-token
NOTES_REMOTE_SYNC_ENABLED=true
# Signup is limited to these addresses and requires a signed, expiring code
# generated with `aube -F @author/web run signup:invite -- you@example.com`.
# NOTES_SIGNUP_ALLOWED_EMAILS=you@example.com,friend@example.com

NOTES_CLEANUP_ENABLED=true
NOTES_CLEANUP_RUN_ON_START=true
NOTES_CLEANUP_INTERVAL_MINUTES=1440
NOTES_BACKUP_ENABLED=true
NOTES_BACKUP_RUN_ON_START=true
NOTES_BACKUP_INTERVAL_MINUTES=1440
NOTES_BACKUP_RETENTION_COUNT=14
# NOTES_BACKUP_DIR=/data/backups

# Android builds read this public API value from the environment/root .env.
# Use the Author HTTP API server that has the Turso variables below.
# For production Android builds, use the public HTTPS Author API URL.
# For the Android emulator against local Vite, use http://10.0.2.2:5173.
AUTHOR_API_URL=https://author.example.com

# Optional legacy static bearer token for existing deployments.
# Leave disabled unless an older client still depends on it:
# NOTES_LEGACY_AUTH_TOKEN_ENABLED=false
# NOTES_AUTH_TOKEN=change-this-local-token

# Optional remote Turso/libSQL database:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Optional record-limit estimates for Turso's free storage budget.
# Limits are per user and shrink/grow with the number of accounts.
# NOTES_RECORD_LIMITS_ENABLED=true
# NOTES_RECORD_LIMIT_STORAGE_BYTES=5000000000
# NOTES_RECORD_LIMIT_SAFETY_RATIO=0.8
# NOTES_RECORD_LIMIT_NOTE_BYTES=24576
# NOTES_RECORD_LIMIT_NOTEBOOK_BYTES=4096

# Optional Cloudflare deploy workflow values.
# Keep the API token scoped to Workers deployment for this app.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional staging remote smoke values. Keep these pointed at a separate
# test/staging Worker and Turso database, never production.
# STAGING_CLOUDFLARE_WORKER_NAME=author-staging
# STAGING_AUTHOR_API_URL=https://author-staging.example.com
# STAGING_TURSO_DATABASE_URL=libsql://your-staging-database.turso.io
# STAGING_TURSO_AUTH_TOKEN=your-staging-turso-token
# STAGING_NOTES_LOGIN_PASSWORD=change-this-staging-login-password
# STAGING_NOTES_SERVER_SECRET=change-this-staging-server-secret
# AUTHOR_REMOTE_TEST_PASSWORD=change-this-remote-test-password
# AUTHOR_REMOTE_TEST_USERNAME=author-remote-test
# AUTHOR_REMOTE_TEST_EMAIL=author-remote-test@example.invalid
