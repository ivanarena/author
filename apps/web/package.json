{
  "name": "@author/web",
  "version": "1.0.21",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:ivanarena/author",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "SVELTEKIT_ADAPTER=node vite build",
    "preview": "SVELTEKIT_ADAPTER=node vite build && vite preview --host 0.0.0.0",
    "cf:build": "SVELTEKIT_ADAPTER=cloudflare vite build && tsx scripts/prepare-cloudflare-worker.ts",
    "cf:dev": "SVELTEKIT_ADAPTER=cloudflare vite build && tsx scripts/prepare-cloudflare-worker.ts && wrangler dev",
    "cf:deploy": "SVELTEKIT_ADAPTER=cloudflare vite build && tsx scripts/prepare-cloudflare-worker.ts && wrangler deploy",
    "cf:deploy:staging": "SVELTEKIT_ADAPTER=cloudflare vite build && tsx scripts/prepare-cloudflare-worker.ts && wrangler deploy --name ${STAGING_CLOUDFLARE_WORKER_NAME:-author-staging}",
    "cf:secrets": "tsx scripts/sync-worker-secrets.ts",
    "cf:secrets:staging": "tsx scripts/sync-worker-secrets.ts --staging",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "seed:test-account": "tsx scripts/seed-test-account.ts",
    "remote:test:seed": "tsx scripts/seed-remote-test-account.ts",
    "remote:test": "tsx scripts/smoke-remote-test-db.ts",
    "user:create": "tsx scripts/create-user.ts",
    "signup:invite": "tsx scripts/create-signup-invitation.ts",
    "db:check": "tsx scripts/check-db-integration.ts",
    "sync:bench": "tsx scripts/benchmark-sync.ts",
    "mock:browser": "tsx scripts/prefill-browser.ts",
    "cleanup": "tsx scripts/cleanup-trash.ts",
    "cleanup:current-only": "tsx scripts/cleanup-current-only-blockers.ts",
    "e2ee:recover": "tsx scripts/recover-e2ee-keyring.ts",
    "prepare": "command -v svelte-kit >/dev/null 2>&1 && svelte-kit sync || true"
  },
  "dependencies": {
    "@author/api-types": "workspace:*",
    "@author/schema": "workspace:*",
    "@author/sync-spec": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/figtree": "^5.2.10",
    "@libsql/client": "^0.17.3",
    "@lucide/svelte": "^1.16.0",
    "@noble/hashes": "^2.2.0",
    "dexie": "^4.4.2",
    "hono": "^4.12.25",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@author/test-fixtures": "workspace:*",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "svelte": "^5.55.10",
    "svelte-check": "^4.4.8",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.11",
    "wrangler": "^4.95.0"
  }
}
