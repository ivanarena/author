# Staging-only template. Copy values into your ignored root `.env` or export
# them before running the staging deploy and smoke-test commands.
# Never point these values at production.

STAGING_CLOUDFLARE_WORKER_NAME=author-staging
STAGING_AUTHOR_API_URL=https://author-staging.example.workers.dev
STAGING_TURSO_DATABASE_URL=libsql://your-staging-database.turso.io
STAGING_TURSO_AUTH_TOKEN=your-staging-turso-token
STAGING_NOTES_LOGIN_PASSWORD=change-this-long-random-staging-bootstrap-password
STAGING_NOTES_SERVER_SECRET=change-this-long-random-staging-server-secret

# Optional staging Worker runtime values.
# STAGING_NOTES_AUTH_SESSION_DAYS=90
# STAGING_NOTES_METRICS_TOKEN=change-this-long-random-staging-metrics-token
# STAGING_NOTES_SIGNUP_ALLOWED_EMAILS=author-remote-test@example.invalid

# Remote smoke account. The scripts require a test/staging-looking target and a
# dedicated author-remote-test account name unless explicitly overridden.
AUTHOR_REMOTE_TEST_USERNAME=author-remote-test
AUTHOR_REMOTE_TEST_EMAIL=author-remote-test@example.invalid
AUTHOR_REMOTE_TEST_PASSWORD=change-this-long-random-remote-test-password
