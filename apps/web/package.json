{
  "name": "@author/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "SVELTEKIT_ADAPTER=node vite build",
    "preview": "SVELTEKIT_ADAPTER=node vite build && vite preview --host 0.0.0.0",
    "cf:build": "SVELTEKIT_ADAPTER=cloudflare vite build",
    "cf:dev": "SVELTEKIT_ADAPTER=cloudflare vite build && wrangler dev",
    "cf:deploy": "SVELTEKIT_ADAPTER=cloudflare vite build && wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "seed:test-account": "tsx scripts/seed-test-account.ts",
    "user:create": "tsx scripts/create-user.ts",
    "db:check": "tsx scripts/check-db-integration.ts",
    "sync:bench": "tsx scripts/benchmark-sync.ts",
    "mock:browser": "tsx scripts/prefill-browser.ts",
    "cleanup": "tsx scripts/cleanup-trash.ts",
    "prepare": "command -v svelte-kit >/dev/null 2>&1 && svelte-kit sync || true"
  },
  "dependencies": {
    "@author/api-types": "workspace:*",
    "@author/schema": "workspace:*",
    "@author/sync-spec": "workspace:*",
    "@fontsource/kedebideri": "^5.2.2",
    "@libsql/client": "^0.17.3",
    "dexie": "^4.4.2",
    "hono": "^4.12.18",
    "@lucide/svelte": "^1.16.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@author/test-fixtures": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.6",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.0"
  }
}
